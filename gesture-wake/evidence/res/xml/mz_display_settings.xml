<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/prv/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto" android:title="@string/display_and_brightness">
    <PreferenceCategory
        android:title="@string/night_mode_category_title"
        android:key="night_mode_category">
        <com.meizu.settings.widget.AppearanceColorModePreference android:key="appearance_mode"/>
        <Preference
            android:title="@string/timing_switch_setting"
            android:key="dark_mode_timing_switch"
            android:widgetLayout="@layout/mz_right_arrow"
            settings:controller="com.meizu.settings.display.FlymeDarkModeScheduledController"/>
        <Preference
            android:title="@string/deep_color_mode_setting"
            android:key="deep_color_mode"
            android:summary="@string/deep_color_mode_setting_summary"
            android:widgetLayout="@layout/mz_right_arrow"
            settings:controller="com.meizu.settings.display.FlymeDarkModeSettingsController"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/brightness_category_title"
        android:key="brightness_category">
        <com.meizu.settings.display.BrightnessPreference
            android:persistent="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:selectable="false"
            android:key="brightness_seekbar"
            settings:controller="com.meizu.settings.display.FlymeBrightnessSeekBarController"
            settings:userRestriction="no_config_brightness"/>
        <com.android.settingslib.RestrictedSwitchPreference
            android:title="@string/automatic_brightness"
            android:key="automatic_brightness"
            settings:controller="com.meizu.settings.display.FlymeAutoBrightnessController"
            settings:userRestriction="no_config_brightness"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/display_settings"
        android:key="display_settings">
        <Preference
            android:title="@string/screen_zoom_and_font_title"
            android:key="font_and_screen_zoom"
            android:widgetLayout="@layout/mz_right_arrow"
            android:fragment="com.meizu.settings.display.FlymeScreenZoomAndFontSizeSettings"
            settings:controller="com.meizu.settings.display.FlymeFontAndScreenZoomController"/>
        <Preference
            android:title="@string/display_mode_settings_title"
            android:key="display_mode"
            android:widgetLayout="@layout/mz_right_arrow"
            settings:controller="com.meizu.settings.display.FlymeDisplayModeController"/>
        <Preference
            android:title="@string/blue_light_reduction_title"
            android:key="night_display"
            android:widgetLayout="@layout/mz_right_arrow"
            android:fragment="com.android.settings.display.NightDisplaySettings"
            settings:controller="com.meizu.settings.display.FlymeNightDisplayController"
            settings:keywords="@string/keywords_display_night_display"/>
        <Preference
            android:title="@string/refresh_rate_category_title"
            android:key="refresh_rate_and_resolution"
            android:widgetLayout="@layout/mz_right_arrow"
            android:fragment="com.meizu.settings.display.FlymeRefreshRateAndResolutionFragment"
            settings:controller="com.meizu.settings.display.FlymeRefreshRateAndResolutionController"/>
        <Preference
            android:title="@string/visual_enhancement_engine_title"
            android:key="visual_enhancement"
            android:summary="@string/visual_enhancement_engine_close_ais_frc_summary"
            android:widgetLayout="@layout/mz_right_arrow"
            android:fragment="com.meizu.flyme.mmfvideo.VisualEnhanceSettingsActivity"
            settings:controller="com.meizu.settings.display.FlymeVisualEnhanceController"/>
        <SwitchPreference
            android:title="@string/source_color_display_title"
            android:key="source_color_display"
            android:summary="@string/source_color_display_summary"
            settings:controller="com.meizu.settings.display.FlymeSourceColorController"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/memory_system"
        android:key="display_system">
        <com.android.settings.display.TimeoutListPreference
            android:persistent="false"
            android:entries="@array/flyme_screen_timeout_entries"
            android:title="@string/screen_timeout"
            android:key="screen_timeout"
            android:summary="@string/screen_timeout_summary"
            android:entryValues="@array/flyme_screen_timeout_values"
            settings:controller="com.meizu.settings.display.FlymeScreenTimeoutController"
            settings:userRestriction="no_config_screen_timeout"/>
        <SwitchPreference
            android:title="@string/adaptive_keep_bright_screen_title"
            android:key="adaptive_keep_bright_screen_switch"
            settings:controller="com.meizu.settings.display.FlymeAdaptiveKeepScreenOnController"/>
        <SwitchPreference
            android:persistent="false"
            android:title="@string/subscreen_double_click_wakeup"
            android:key="quick_wakeup_double_click"
            settings:controller="com.meizu.settings.display.FlymeDoubleClickWakeUpController"/>
        <SwitchPreference
            android:title="@string/raise_flip_config_title"
            android:key="raise_flip"
            settings:controller="com.meizu.settings.display.FlymeRaiseFlipController"/>
        <SwitchPreference
            android:title="@string/accelerometer_title"
            android:key="auto_rotate"
            settings:controller="com.meizu.settings.display.FlymeAutoRotateController"/>
        <Preference
            android:title="@string/lockscreen_settings_title"
            android:key="lockscreen_from_display_settings"
            android:fragment="com.android.settings.security.LockscreenDashboardFragment"
            settings:controller="com.android.settings.security.screenlock.LockScreenPreferenceController"
            settings:keywords="@string/keywords_ambient_display_screen"/>
        <Preference
            android:title="@string/r_angle_adjust"
            android:key="r_angle_adjust"
            android:widgetLayout="@layout/mz_right_arrow"
            android:fragment="com.meizu.settings.display.RAngleAdjust.FlymeRAngleSettingsFragment"
            settings:controller="com.meizu.settings.display.FlymeRAngleController"/>
    </PreferenceCategory>
</PreferenceScreen>
