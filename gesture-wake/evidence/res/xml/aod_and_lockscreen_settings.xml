<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/prv/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/aod_and_lockscreen_title"
    android:key="aod_and_lockscreen">
    <PreferenceCategory android:title="@string/aod_title"/>
    <com.meizu.settings.display.aod.AODPreference android:key="aod_image"/>
    <SwitchPreference
        android:title="@string/aod_switch"
        android:key="aod_switch"/>
    <Preference
        android:title="@string/aod_display_style_title"
        android:key="aod_style"
        android:widgetLayout="@layout/mz_right_arrow"/>
    <Preference
        android:title="@string/aod_display_mode_title"
        android:key="aod_mode"
        android:widgetLayout="@layout/mz_right_arrow"
        android:fragment="com.meizu.settings.lockscreen_aod.aod.fragment.AODModeSelectFragment"/>
    <Preference
        android:title="@string/aod_coming_notification_style"
        android:key="aod_coming_notification_anim"
        android:widgetLayout="@layout/mz_right_arrow"/>
    <PreferenceCategory
        android:title="@string/lockscreen_category_title"
        android:key="lockscreen_category"/>
    <Preference
        android:title="@string/lockscreen_layout"
        android:key="lockscreen_layout"
        android:widgetLayout="@layout/mz_right_arrow"/>
    <SwitchPreference
        android:persistent="false"
        android:title="@string/lockscreen_access_control_center"
        android:key="lockscreen_pull_down_notibar"/>
    <SwitchPreference
        android:persistent="false"
        android:title="@string/lockscreen_trivial_controls_setting_toggle"
        android:key="device_controls"/>
    <SwitchPreference
        android:persistent="false"
        android:key="lockscreen_show_music_key"
        settings:searchable="false"/>
    <Preference
        android:title="@string/lockscreen_poster"
        android:key="lockscreen_poster"
        android:widgetLayout="@layout/mz_right_arrow"/>
    <com.android.settings.display.TimeoutListPreference
        android:persistent="false"
        android:entries="@array/flyme_screen_timeout_entries"
        android:title="@string/screen_timeout"
        android:key="screen_timeout"
        android:summary="@string/screen_timeout_summary"
        android:entryValues="@array/flyme_screen_timeout_values"
        settings:userRestriction="no_config_screen_timeout"/>
    <SwitchPreference
        android:title="@string/adaptive_keep_bright_screen_title"
        android:key="adaptive_keep_bright_screen_switch"/>
    <SwitchPreference
        android:persistent="false"
        android:title="@string/subscreen_double_click_wakeup"
        android:key="quick_wakeup_double_click"/>
    <SwitchPreference
        android:title="@string/raise_flip_config_title"
        android:key="raise_flip"/>
    <SwitchPreference
        android:title="@string/accelerometer_title"
        android:key="auto_rotate"/>
    <com.android.settingslib.RestrictedPreference
        android:title="@string/owner_info_settings_title"
        android:key="owner_info_settings"
        android:summary="@string/owner_info_settings_summary"/>
</PreferenceScreen>
